$C = "../../Common.ui";

Group #MetricCard {
  Anchor: (Width: 220, Height: 56);
  Background: #101922;

  Group #MetricAccent {
    Anchor: (Left: 0, Top: 0, Width: 4, Bottom: 0);
    Background: #ef4444;
    HitTestVisible: false;
  }

  Group #MetricIconFrame {
    Anchor: (Left: 12, Top: 12, Width: 32, Height: 32);
    Background: #ef4444;
    Visible: false;
    Label #MetricIcon { Anchor: (Full: 0); Text: ""; Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); HitTestVisible: false; }
  }

  Group #MetricStateBadge {
    Anchor: (Right: 10, Top: 7, Width: 48, Height: 14);
    Background: #64748b;
    Visible: false;
    Label #MetricStateLabel { Anchor: (Full: 0); Text: ""; Style: (FontSize: 8, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); HitTestVisible: false; }
  }

  Label #MetricLabel {
    Anchor: (Left: 52, Top: 6, Right: 62, Height: 12);
    Text: "";
    Style: (FontSize: 10, TextColor: #8ea2b5, RenderBold: true);
    HitTestVisible: false;
  }

  Label #MetricValue {
    Anchor: (Left: 52, Top: 20, Right: 12, Height: 18);
    Text: "";
    Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true);
    HitTestVisible: false;
  }

  Label #MetricDetail {
    Anchor: (Left: 52, Top: 40, Right: 12, Height: 12);
    Text: "";
    Style: (FontSize: 10, TextColor: #b7c7d6);
    HitTestVisible: false;
  }
}
